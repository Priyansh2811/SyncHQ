generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}
enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}
enum Plan {
  FREE
  PRO
  BUSINESS
}
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(320)
  name            String   @db.VarChar(100)
  passwordHash    String
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  preferences     Json @default("{}")
  sessions        Session[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  authoredMessages Message[]
  sentInvitations Invitation[] @relation("InvitationInviter")
  auditEvents     AuditLog[]
  resetTokens     PasswordResetToken[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Workspace {
  id                    String @id @default(uuid()) @db.Uuid
  name                  String @db.VarChar(80)
  slug                  String @unique @db.VarChar(50)
  ownerId               String @db.Uuid
  stripeCustomerId      String? @unique
  stripeSubscriptionId  String? @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  owner                 User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members               WorkspaceMember[]
  channels              Channel[]
  messages              Message[]
  subscription          Subscription?
  invitations           Invitation[]
  auditLogs             AuditLog[]
  @@index([ownerId])
}

model WorkspaceMember {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  userId      String @db.Uuid
  role        Role @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Channel {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  name        String @db.VarChar(80)
  slug        String @db.VarChar(80)
  description String? @db.VarChar(500)
  isPrivate   Boolean @default(false)
  createdById String @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Message {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  channelId   String @db.Uuid
  authorId    String @db.Uuid
  clientId    String? @db.VarChar(80)
  content     String @db.VarChar(10000)
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([workspaceId])
  @@index([channelId, createdAt])
  @@unique([channelId, authorId, clientId])
}

model Subscription {
  id                   String @id @default(uuid()) @db.Uuid
  workspaceId          String @unique @db.Uuid
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  status               SubscriptionStatus @default(ACTIVE)
  plan                 Plan @default(FREE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  email       String @db.VarChar(320)
  role        Role @default(MEMBER)
  tokenHash   String @unique
  inviterId   String @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  @@unique([workspaceId, email])
  @@index([workspaceId, expiresAt])
}

model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model WaitlistEntry {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique @db.VarChar(320)
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  actorId     String? @db.Uuid
  action      String @db.VarChar(100)
  targetType  String @db.VarChar(60)
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
}

model ContactSubmission {
  id        String @id @default(uuid()) @db.Uuid
  name      String @db.VarChar(100)
  email     String @db.VarChar(320)
  subject   String @db.VarChar(160)
  message   String @db.VarChar(10000)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model StripeEvent {
  id        String @id
  type      String @db.VarChar(100)
  createdAt DateTime @default(now())
}
